{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Reconciled Ledger Schema",
  "description": "The Financial agent's ledger output. Built from Logistics structured records. Every row traces to a source document.",
  "type": "object",
  "required": ["period", "generated_at", "currency", "rows", "summary"],
  "properties": {
    "period": {
      "type": "string",
      "description": "The month being closed, e.g. '2026-09'"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of when the ledger was generated"
    },
    "currency": {
      "type": "string",
      "enum": ["MYR"],
      "default": "MYR"
    },
    "rows": {
      "type": "array",
      "description": "One row per line item extracted from source documents. Cash out = expense, cash in = income.",
      "items": {
        "type": "object",
        "required": ["row_id", "direction", "category", "description", "amount", "source_ref", "document_type", "document_number", "document_date", "confidence"],
        "properties": {
          "row_id": {
            "type": "string",
            "description": "Unique ledger row ID, e.g. 'LED-0001'"
          },
          "direction": {
            "type": "string",
            "enum": ["in", "out"],
            "description": "in = cash received, out = cash paid"
          },
          "category": {
            "type": "string",
            "enum": ["COGS", "RENT", "UTIL", "SALARY", "SUPPLIES", "MARKETING", "MAINT", "TRANSPORT", "FEES", "MISC"],
            "description": "Expense or income category code"
          },
          "description": {
            "type": "string",
            "description": "Line item description from the source document"
          },
          "quantity": {
            "type": ["number", "null"],
            "description": "Quantity if applicable"
          },
          "unit_price": {
            "type": ["number", "null"],
            "description": "Unit price if applicable"
          },
          "amount": {
            "type": "number",
            "description": "Line item total (quantity * unit_price). Excludes tax for out rows unless tax is included in the printed price."
          },
          "tax_amount": {
            "type": ["number", "null"],
            "description": "SST portion for this line item"
          },
          "amount_incl_tax": {
            "type": ["number", "null"],
            "description": "Amount including SST, if applicable"
          },
          "source_ref": {
            "type": "string",
            "description": "Reference to the source document (filename/hash/path) — traceability"
          },
          "document_type": {
            "type": "string",
            "enum": ["invoice", "receipt", "order"]
          },
          "document_number": {
            "type": "string",
            "description": "Invoice number, receipt number, or PO number from the source document"
          },
          "document_date": {
            "type": "string",
            "format": "date",
            "description": "Date on the source document"
          },
          "vendor_name": {
            "type": "string",
            "description": "Vendor/supplier name"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Lowest confidence among critical fields (vendor, amount, date). If below 0.7, escalation is triggered."
          },
          "reconciled": {
            "type": "boolean",
            "default": false,
            "description": "true if a matching receipt (payment proof) exists for this invoice/expense"
          },
          "reconciled_with": {
            "type": ["string", "null"],
            "description": "source_ref of the matching receipt, if reconciled"
          },
          "flags": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Flags carried over from the source record or raised during processing"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["total_in", "total_out", "total_tax", "net_cash_flow", "by_category"],
      "properties": {
        "total_in": {
          "type": "number",
          "description": "Total cash received"
        },
        "total_out": {
          "type": "number",
          "description": "Total cash paid (excluding tax)"
        },
        "total_tax": {
          "type": "number",
          "description": "Total SST across all line items"
        },
        "net_cash_flow": {
          "type": "number",
          "description": "total_in - total_out - total_tax"
        },
        "by_category": {
          "type": "array",
          "description": "Expense breakdown by category code",
          "items": {
            "type": "object",
            "required": ["category", "total_amount", "row_count"],
            "properties": {
              "category": {
                "type": "string",
                "enum": ["COGS", "RENT", "UTIL", "SALARY", "SUPPLIES", "MARKETING", "MAINT", "TRANSPORT", "FEES", "MISC"]
              },
              "total_amount": { "type": "number" },
              "total_tax": { "type": "number" },
              "row_count": { "type": "integer" }
            }
          }
        },
        "reconciliation_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Fraction of invoice rows that have a matching receipt"
        },
        "document_count": {
          "type": "integer",
          "description": "Total number of source documents processed"
        },
        "flagged_row_count": {
          "type": "integer",
          "description": "Number of ledger rows with flags"
        }
      }
    }
  }
}
