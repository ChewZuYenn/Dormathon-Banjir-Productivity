{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Receipt Extraction Schema",
  "description": "Structured record extracted from a Malaysian receipt (payment proof). Logistics owns this — never computes a grand total.",
  "type": "object",
  "required": ["document_type", "vendor_name", "receipt_date", "amount", "currency", "source_ref"],
  "properties": {
    "document_type": {
      "type": "string",
      "enum": ["receipt"]
    },
    "vendor_name": {
      "type": "string",
      "description": "Vendor or payee name"
    },
    "receipt_number": {
      "type": ["string", "null"],
      "description": "Receipt number if present"
    },
    "receipt_date": {
      "type": "string",
      "format": "date"
    },
    "payment_method": {
      "type": ["string", "null"],
      "enum": ["cash", "cheque", "bank_transfer", "card", "ewallet", "duitnow", null],
      "description": "Payment method if discernible"
    },
    "amount": {
      "type": "number",
      "minimum": 0,
      "description": "Amount paid as printed. Recorded, not computed."
    },
    "tax_amount": {
      "type": ["number", "null"],
      "description": "SST portion if broken out on receipt"
    },
    "invoice_reference": {
      "type": ["string", "null"],
      "description": "Linked invoice number if present"
    },
    "currency": {
      "type": "string",
      "enum": ["MYR", "RM"],
      "default": "MYR"
    },
    "source_ref": {
      "type": "string",
      "description": "Reference to source document for traceability"
    },
    "confidence": {
      "type": "object",
      "properties": {
        "vendor_name": { "type": "number" },
        "receipt_date": { "type": "number" },
        "amount": { "type": "number" },
        "payment_method": { "type": "number" }
      }
    },
    "status": {
      "type": "string",
      "enum": ["clean", "flagged", "error"],
      "default": "clean"
    },
    "flags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Issues, e.g., ['handwritten', 'blurry_image', 'no_receipt_number']"
    }
  }
}
