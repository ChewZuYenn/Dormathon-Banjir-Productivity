{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Invoice Extraction Schema",
  "description": "Structured record extracted from a Malaysian invoice. Logistics owns this — never computes a grand total.",
  "type": "object",
  "required": ["document_type", "vendor_name", "invoice_number", "invoice_date", "line_items", "currency", "source_ref"],
  "properties": {
    "document_type": {
      "type": "string",
      "enum": ["invoice"],
      "description": "Always 'invoice' for this schema"
    },
    "vendor_name": {
      "type": "string",
      "description": "Vendor / supplier name as printed"
    },
    "vendor_sst_id": {
      "type": "string",
      "description": "SST registration number if present",
      "pattern": "^\\w{2}-\\d{8}-\\d{4}$|^$"
    },
    "invoice_number": {
      "type": "string",
      "description": "Invoice number as printed"
    },
    "invoice_date": {
      "type": "string",
      "format": "date",
      "description": "Invoice date in YYYY-MM-DD format"
    },
    "due_date": {
      "type": ["string", "null"],
      "format": "date",
      "description": "Payment due date if present"
    },
    "po_reference": {
      "type": ["string", "null"],
      "description": "Purchase order reference if present. May be missing — flag, do not guess."
    },
    "line_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["description", "quantity", "unit_price", "tax_amount"],
        "properties": {
          "description": { "type": "string" },
          "quantity": { "type": "number", "minimum": 0 },
          "unit_price": { "type": "number", "minimum": 0 },
          "tax_amount": {
            "type": "number",
            "minimum": 0,
            "description": "SST amount per line. 0 if not applicable."
          },
          "tax_rate": {
            "type": ["number", "null"],
            "description": "SST rate if stated (e.g., 6, 8)"
          }
        }
      }
    },
    "subtotal": {
      "type": ["number", "null"],
      "description": "Subtotal before tax if printed. Null if not on document."
    },
    "total_tax": {
      "type": ["number", "null"],
      "description": "Total SST if printed. Null if not on document."
    },
    "grand_total": {
      "type": ["number", "null"],
      "description": "Grand total as printed. Logistics records it but NEVER computes or validates it."
    },
    "currency": {
      "type": "string",
      "enum": ["MYR", "RM"],
      "default": "MYR"
    },
    "source_ref": {
      "type": "string",
      "description": "Reference to the source document (filename, hash, or path) for traceability"
    },
    "confidence": {
      "type": "object",
      "description": "Per-field confidence score 0.0–1.0",
      "properties": {
        "vendor_name": { "type": "number" },
        "invoice_number": { "type": "number" },
        "invoice_date": { "type": "number" },
        "po_reference": { "type": "number" },
        "line_items": { "type": "number" },
        "grand_total": { "type": "number" }
      }
    },
    "status": {
      "type": "string",
      "enum": ["clean", "flagged", "error"],
      "default": "clean",
      "description": "clean = extracted with high confidence; flagged = low confidence or missing field; error = unparseable"
    },
    "flags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of issues, e.g., ['no_po_reference', 'blurry_image', 'handwritten', 'total_mismatch']"
    }
  }
}
